# Database
# Local dev uses SQLite (zero-config). For production, point this at a
# PostgreSQL instance and change prisma/schema.prisma provider to
# "postgresql" — see README.md "Switching to PostgreSQL".
DATABASE_URL="file:./dev.db"

# Auth
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# AI / LLM (optional)
# When unset, the AI Business Copilot and recommendation explanations fall
# back to a deterministic template-based engine — the app is fully
# functional without this key. Set it to enable richer natural-language
# answers grounded in the same database queries.
ANTHROPIC_API_KEY=""

# Scheduled recompute (classify/forecast/recommend/alert pipeline)
# In-process scheduler (src/instrumentation.ts) re-runs it on this interval
# for every business — only relevant for a long-running server process.
RECOMPUTE_INTERVAL_MINUTES="360"
# Shared secret for the HTTP-triggered alternative (POST /api/cron/recompute),
# for serverless deployments where an external scheduler must call in.
# Required in production; optional in development.
CRON_SECRET=""
# Set to "true" to disable the in-process scheduler entirely.
DISABLE_RECOMPUTE_SCHEDULER=""

# App
NODE_ENV="development"
